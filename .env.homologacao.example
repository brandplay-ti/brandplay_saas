# Copie para .env.homologacao na raiz do repositorio.
# Esse arquivo e ignorado pelo Git. Nao coloque senha de banco, service role
# nem JWT_SECRET aqui — o diagnostico ignora essas chaves se elas aparecerem.
#
# Uso: npm run supabase:diagnosticar
# Runbook: docs/runbooks/diagnostico-homologacao.md

AMBIENTE=homologacao

# API publica de homologacao. A anon key e a mesma do portal publicado.
# Tambem valem os nomes do Vite: VITE_SUPABASE_URL e VITE_SUPABASE_PUBLISHABLE_KEY
# (ou VITE_PUBLIC_SUPABASE_URL e VITE_PUBLIC_SUPABASE_ANON_KEY).
# Sem AMBIENTE, o host precisa ter rotulo hml, homologacao, staging ou teste.
SUPABASE_URL=https://api.hml.exemplo.com
SUPABASE_ANON_KEY=
PORTAL_URL=https://hml.exemplo.com

# SSH da VPS. A senha do Postgres continua em /etc/brandplay/homologacao.env,
# e SUPABASE_NETWORK precisa conter "hml" ou "homolog" (ex.: brandplay-hml_default).
VPS_HOST=
VPS_USER=
# Opcional. Sem isto, o ssh usa a chave padrao desta maquina.
# VPS_SSH_KEY=

# Painel do Dockploy (Dokploy). A URL e a do painel, unica para os dois
# ambientes. O comando so le servico cujo nome tem hml/homologacao.
# Chave em Settings, Profile, API/CLI. Trate-a como segredo: fora deste
# comando ela nao e limitada a leitura.
DOCKPLOY_URL=https://dockploy.exemplo.com
DOCKPLOY_API_KEY=
# Opcional, para ler so um servico. O id esta na URL do servico no painel.
# DOCKPLOY_COMPOSE_ID=
# DOCKPLOY_APPLICATION_ID=
