# Referencia das variaveis do projeto.
#
# Este arquivo NAO e carregado por nada: serve de indice de onde cada variavel
# realmente vive.
#
#   desenvolvimento local  -> docker/supabase/.env   (stack e Edge Functions)
#                             portal/.env.local      (frontend, VITE_PUBLIC_*)
#   homologacao/producao   -> Dockploy (docs/architecture/deployment.md)
#
# Nunca prefixe segredo com VITE_: tudo com esse prefixo vai para o bundle do
# navegador.

# ── Portal (build arguments no Dockploy) ──
VITE_PUBLIC_SUPABASE_URL=
VITE_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase (servico do stack no Dockploy) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ── IA: Anthropic (ADR-0003) ──
ANTHROPIC_API_KEY=

# ── E-mail transacional: Resend ──
RESEND_API_KEY=
RESEND_FROM_DOMAIN=
EMAIL_FROM=

# ── Aplicacao ──
APP_URL=http://localhost:8080
