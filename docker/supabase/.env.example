# Configuracao do stack do Supabase.
#
# Copie para `.env` neste mesmo diretorio e preencha. O `.env` esta no
# .gitignore; este arquivo, nao — entao NUNCA ponha valor real aqui.
#
# ─── Os segredos sao gerados, nao escolhidos ─────────────────────────
#
#   npm run supabase:chaves
#
# ANON_KEY e SERVICE_ROLE_KEY sao JWTs assinados com o JWT_SECRET: inventar um
# sem regerar os outros dois produz um stack em que nada autentica, com erro que
# nao menciona nenhum dos tres.
#
# **Os valores locais nunca se reaproveitam em homologacao ou producao, e o
# contrario e pior**: trazer a chave de um ambiente publicado para a maquina de
# desenvolvimento poe acesso real onde ele nao deveria estar.
#
# Em homologacao e producao estes valores vivem no Dockploy, nao em arquivo.

# ─── Identidade do stack ─────────────────────────────────────────────
# Cada ambiente precisa do proprio: dois projetos com o mesmo nome no mesmo host
# colidem em rede e volumes.
COMPOSE_PROJECT_NAME=brandplay-supabase

# ─── Banco ───────────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# Superusuario do banco. E o padrao da propria imagem supabase/postgres, e o
# compose NAO o repassa ao container: sobrescreve-lo quebra o init da imagem.
# Fica aqui porque os scripts de migracao conectam com ele.
POSTGRES_USER=supabase_admin
POSTGRES_PASSWORD=

# ─── Chaves e segredos (npm run supabase:chaves) ─────────────────────
JWT_SECRET=
JWT_EXPIRY=3600
JWT_KEYS=[]
JWT_JWKS=
ANON_KEY=
SERVICE_ROLE_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SECRET_KEY_BASE=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=
REALTIME_DB_ENC_KEY=

# ─── Studio (basic auth do dashboard, pelo Kong) ─────────────────────
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=
STUDIO_DEFAULT_ORGANIZATION=BrandPlay
STUDIO_DEFAULT_PROJECT=brandplay
# Opcional: habilita o assistente de SQL do Studio. Vazio desliga.
OPENAI_API_KEY=

# ─── Enderecos ───────────────────────────────────────────────────────
# API_EXTERNAL_URL e SUPABASE_PUBLIC_URL sao o endereco do Supabase visto de
# fora. SITE_URL e o do PORTAL — e o que decide para onde vao os links dos
# e-mails de cadastro e recuperacao.
#
# Um SITE_URL esquecido no padrao manda todo mundo para localhost e **nada
# falha**: a conta e criada, o e-mail sai, so o usuario e que nao chega a lugar
# nenhum. Destino fora de ADDITIONAL_REDIRECT_URLS e descartado em silencio.
SUPABASE_HOST=localhost
API_EXTERNAL_URL=http://localhost:8010
SUPABASE_PUBLIC_URL=http://localhost:8010
SITE_URL=http://localhost:8080
ADDITIONAL_REDIRECT_URLS=http://localhost:8080

# ─── Autenticacao ────────────────────────────────────────────────────
# ENABLE_EMAIL_AUTOCONFIRM fica `false` de proposito, igual aos ambientes
# hospedados: o fluxo de confirmacao e exercitado aqui, e o e-mail cai no
# Mailpit (http://localhost:8026) em vez de sair de verdade.
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
# `true` de proposito (ADR-0014). O GoTrue so tem dois estados: `false`
# bloqueia o login ate confirmar, `true` marca como confirmado e nao pergunta
# mais. Bloquear derruba de 10% a 30% dos cadastros — caro num fluxo que termina
# em compra. Com `true` o signup devolve sessao, e quem passa a controlar a
# verificacao e a aplicacao, em `profiles.email_verificado_em`.
#
# **Nao leia `auth.users.email_confirmed_at` como prova de confirmacao**: com
# autoconfirm ligado ele e sempre preenchido.
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# ─── SMTP ────────────────────────────────────────────────────────────
# Local aponta para o Mailpit do override. A variavel e a mesma que em producao
# aponta para o provedor real — o servico e que muda, nao o contrato.
#
# SMTP_USER e SMTP_PASS ficam VAZIAS no local, de proposito. Com credenciais
# definidas o GoTrue tenta autenticar, e o `net/smtp` do Go recusa mandar
# credencial por conexao nao criptografada — o Mailpit e texto claro. O signup
# falha com 500 e `Error sending confirmation email`, e o log diz apenas
# `unencrypted connection`, sem mencionar credencial.
#
# Em homologacao e producao elas sao preenchidas, e o provedor tem TLS.
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=dev@brandplay.local
SMTP_SENDER_NAME=BrandPlay (dev)

# Remetente dos e-mails que a aplicacao envia pelo Resend (convite,
# verificacao, notificacoes). Vazio cai no remetente de teste do Resend, que so
# entrega para o e-mail dono da conta.
EMAIL_FROM=

# Base dos links que saem por e-mail (convites, notificacoes). Antes um hack no
# Lovable Cloud trocava o dominio por `.lovable.app`; agora e uma variavel de
# ambiente de verdade, lida pela Edge Function `check-notifications`.
APP_URL=http://localhost:8080

# ─── PostgREST ───────────────────────────────────────────────────────
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

# ─── Storage ─────────────────────────────────────────────────────────
# Backend em arquivo; os campos S3 existem porque a imagem os exige.
GLOBAL_S3_BUCKET=stub
REGION=local
STORAGE_TENANT_ID=stub
S3_PROTOCOL_ACCESS_KEY_ID=stub
S3_PROTOCOL_ACCESS_KEY_SECRET=stub
IMGPROXY_AUTO_WEBP=true

# ─── Edge Functions ──────────────────────────────────────────────────
# As funcoes vem de `supabase/functions/`, montado direto no container.
FUNCTIONS_VERIFY_JWT=false
REDIS_URL=redis://redis:6379

# Segredos das integracoes. Ficam SO aqui, nunca no bundle do portal.
RESEND_API_KEY=
RESEND_FROM_DOMAIN=

# IA (ADR-0003): as Edge Functions que geravam texto via gateway do Lovable
# (ai.gateway.lovable.dev + LOVABLE_API_KEY) agora chamam a API da Anthropic
# diretamente.
ANTHROPIC_API_KEY=

# ─── Pooler (supavisor) ──────────────────────────────────────────────
POOLER_TENANT_ID=
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5

# ─── Portas publicadas — SO no ambiente local ────────────────────────
# Lidas apenas por `docker-compose.local.yml`. Nos ambientes hospedados nada e
# publicado no host: quem expoe e o Traefik.
#
# Bloco de portas PROPRIO deste projeto (ver docs/infrastructure/padrao-de-projeto.md):
# o central-check usa 8000/54322/54323/6379/8025 e o portal dele na 3000. Com
# blocos distintos os dois stacks sobem juntos na mesma maquina, sem colisao.
KONG_HTTP_PORT_HOST=8010
STUDIO_PORT_HOST=54325
POSTGRES_PORT_HOST=54324
REDIS_PORT_HOST=6380
MAIL_UI_PORT_HOST=8026
